<!--
  T-McpToolset/T-McpToolset2：MCP 可选依赖描述文件（官方规范：<depends optional="true" config-file="...">）。

  本文件仅在 com.intellij.mcpServer 插件存在时加载（IDEA 2025.2+/2026.x 内置；更早版本需从
  Marketplace 安装 253 分支包；243 的 1.0.30 为旧 EP 形态——不支持，见 CHANGELOG）。
  声明在本文件的扩展引用的类（mcp/ 包各 Tool 类及其引用的 com.intellij.mcpserver.* 类型）
  只会在 mcpServer 插件在场时实例化/解析——未装环境整文件不加载，自动降级零影响。

  T-MTS2-00：一工具一 toolset 类（平台 per-tool 门控只有 toolset 粒度 isEnabled；
  McpToolsetSupport 基类三钩子字面量覆写 → McpToolGate 读插件设置，插件设置页
  「MCP 工具」可总开关与逐工具启用/禁用）。

  T-McpToolNaming：toolset 类名统一加 `SqlVisualizer` 前缀——平台「暴露工具」页的分组名即
  类的 simpleName（ToolsetReflection_utilKt.asTools 字节码实证），前缀使十组在列表中组名
  自带插件名且字典序相邻；工具名统一 `sqlv_` 前缀（@McpTool name 与门控设置键同源）。
-->
<idea-plugin>
    <!-- 平台 MCP Server 工具集 ×10（全部只读，isExperimental=false 稳定集；EP 名
         com.intellij.mcpServer.mcpToolset 为 mcpserver.jar 字节码 ldc 实证）。编译期类型来自
         mcpStub 桩源集（运行时解析平台内置插件真类，桩产物不进插件 jar——详见 build.gradle.kts
         mcpStub 注释）。 -->
    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerRenderSqlTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerSchemaContextTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerExplainTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerRenderLogsTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerCheckSqlTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerRollbackPlanTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerPerfAdviceTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerCrudSqlTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerReverseSqlTool"/>
        <mcpServer.mcpToolset implementation="cn.song.mybatisplus.visualizer.mcp.SqlVisualizerMapperCheckTool"/>
        <!-- T-McpGateDynamicFilter（O-68）：外部会话清单过滤注册器（探测式，262+ 命中 / 253 静默
             跳过，见 McpGateFilterRegistrar 头注；不得把该过滤 EP 直接 XML 声明进本文件——
             253 无此 EP 会拒载本文件连坐十个 toolset；亦不得为本 EP 加第二条 mcpServer
             depends——verifier 判 duplicated dependency 结构缺陷） -->
        <postStartupActivity implementation="cn.song.mybatisplus.visualizer.mcp.McpGateFilterRegistrar"/>
    </extensions>
</idea-plugin>
