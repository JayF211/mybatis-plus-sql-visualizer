<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件唯一标识（FQN），发布后不可变更 -->
    <id>cn.song.mybatisplus.visualizer.mybatis-plus-sql-visualizer</id>

    <!-- 插件显示名称（M13.1 统一为完整名） -->
    <name>MyBatis-Plus SQL Visualizer</name>
    <!-- 插件图标：不声明 <icon>，走 IDEA 约定路径（jar 根 pluginIcon.svg / pluginIcon_dark.svg，亮暗主题自动切换，M14） -->

    <!-- 插件厂商（发布前请替换为真实信息） -->
    <vendor url="https://gitee.com/SongRenShuo">SongRenShuo</vendor>

    <!-- 插件描述（Marketplace 展示，支持 HTML；必须以拉丁字符开头且 ≥40 字符） -->
    <description><![CDATA[
        MyBatis-Plus SQL Visualizer converts MyBatis-Plus (and MyBatis-Plus-Join) Wrapper chains into readable, copyable SQL with resolved parameters directly inside IntelliJ IDEA.
        <br/>
        <h2>Core capabilities</h2>
        <ul>
            <li>LambdaQueryWrapper / LambdaUpdateWrapper / LambdaDeleteWrapper / MPJLambdaWrapper / MPJQueryWrapper to SQL</li>
            <li>Replace <code>?</code> placeholders with actual parameter values (primitives, objects, collections)</li>
            <li>Auto SQL formatting (keyword uppercase, clause indentation)</li>
            <li>Trigger via context menu / shortcut / hover / gutter icon, one-click copy</li>
            <li>Multiple SQL dialects (MySQL / PostgreSQL / Oracle)</li>
        </ul>
        <p>See the project <code>docs/</code> directory for the development plan and feature overview.</p>
        ]]></description>

    <!-- 插件兼容性声明 -->
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <!-- com.intellij 扩展点注册（M3 展示层 + M5 配置系统） -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 全局配置（application-level，F-16） -->
        <applicationService serviceImplementation="cn.song.mybatisplus.visualizer.config.PluginSettings"/>

        <!-- SQL 预览服务（project-level，统一转换入口） -->
        <projectService serviceImplementation="cn.song.mybatisplus.visualizer.ui.SqlPreviewService"/>

        <!-- 设置页：Settings → Tools → MyBatis-Plus SQL Visualizer
             （官方规范：必须用 applicationConfigurable 注册；com.intellij.configurable 为 abstract EP 不可直接注册） -->
        <applicationConfigurable parentId="tools"
                                 id="cn.song.mybatisplus.visualizer.settings"
                                 displayName="MyBatis-Plus SQL Visualizer"
                                 instance="cn.song.mybatisplus.visualizer.config.PluginSettingsConfigurable"/>

        <!-- M10 gutter 预览图标：Wrapper 锚点行显示预览 SQL 图标（快速路径单元素 O(1) 判定，见 M10 开发计划 §2.4） -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.SqlGutterLineMarkerProvider"/>

        <!-- M9 可编辑 SQL 的补全基础设施：预览语言 PSI + 补全器 + 文件类型 -->
        <lang.parserDefinition language="MP_SQL_Preview"
                               implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.SqlParserDefinition"/>
        <completion.contributor language="MP_SQL_Preview"
                               implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.SqlCompletionContributor"/>
        <fileType name="MP_SQL_Preview" extensions="mpsql" language="MP_SQL_Preview"
                  implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.SqlPreviewFileType"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <!-- Action 注册（F-04 右键菜单 + F-05 快捷键）；图标复用插件图标（M13.1） -->
    <actions>
        <action id="cn.song.mybatisplus.visualizer.ConvertToSql"
                class="cn.song.mybatisplus.visualizer.actions.ConvertToSqlAction"
                text="Convert to SQL"
                description="将光标处的 MyBatis-Plus Wrapper 转换为 SQL"
                icon="/META-INF/pluginIcon.svg">
            <!-- 右键菜单：编辑器弹出菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- 快捷键（M14.5 调整默认值）：Alt+Shift+Q（Q=Query，IDEA 默认 Keymap 未占用）；
                 原 Ctrl+Alt+S 与 IDE 打开 Settings 冲突、Ctrl+Alt+Q 为用户自选前的过渡默认；
                 Windows/Linux 与 macOS 各注册一份，可在 Keymap 或插件设置页修改 -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift Q"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift Q"/>
        </action>
    </actions>
</idea-plugin>
