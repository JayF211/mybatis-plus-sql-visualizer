<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件唯一标识（FQN），发布后不可变更 -->
    <id>cn.song.mybatisplus.visualizer.mybatis-plus-sql-visualizer</id>

    <!-- 插件兼容 IDE 版本（M17：强制要求兼容 IDEA 2025.3+）——
         since-build=253（2025.3 构建号前缀）；不设 until-build（兼容至最新）。
         构建平台为最低支持版本 Ultimate 2025.3.5，公共 API 向后兼容保证 2026.x 可运行 -->
    <idea-version since-build="253"/>

    <!-- 消息 bundle 声明（M16 i18n）：plugin.xml 中 action text/description 按 action.<id>.<prop> 约定、
         configurable displayName 按 bundle+key 属性，从 messages.MpSqlVisualizerBundle（含 _zh）解析本地化 -->
    <resource-bundle>messages.MpSqlVisualizerBundle</resource-bundle>

    <!-- 插件显示名称（M13.1 统一为完整名） -->
    <name>MyBatis-Plus SQL Visualizer</name>
    <!-- 插件图标：不声明 <icon>，走 IDEA 约定路径（jar 根 pluginIcon.svg / pluginIcon_dark.svg，亮暗主题自动切换，M14） -->

    <!-- 插件厂商（发布前请替换为真实信息） -->
    <vendor url="https://gitee.com/SongRenShuo">SongRenShuo</vendor>

    <!-- 插件描述（Marketplace 展示，支持 HTML；必须以拉丁字符开头且 ≥40 字符；双语：英文在上、中文在下，M16） -->
    <description><![CDATA[
        MyBatis-Plus SQL Visualizer converts MyBatis-Plus (and MyBatis-Plus-Join) Wrapper chains into readable, copyable SQL with resolved parameters directly inside IntelliJ IDEA.
        <br/>
        <h2>Core capabilities</h2>
        <ul>
            <li>LambdaQueryWrapper / LambdaUpdateWrapper / LambdaDeleteWrapper / MPJLambdaWrapper / MPJQueryWrapper to SQL</li>
            <li>Replace <code>?</code> placeholders with actual parameter values (primitives, objects, collections)</li>
            <li>Auto SQL formatting (keyword uppercase, clause indentation)</li>
            <li>Trigger via context menu / shortcut / hover / gutter icon, one-click copy</li>
            <li>Multiple SQL dialects (MySQL / PostgreSQL / Oracle)</li>
        </ul>
        <p>See the project <code>docs/</code> directory for the development plan and feature overview.</p>
        <hr/>
        <h2>核心能力（中文说明）</h2>
        <ul>
            <li>将 <code>LambdaQueryWrapper</code> / <code>LambdaUpdateWrapper</code> / <code>LambdaDeleteWrapper</code> / <code>MPJLambdaWrapper</code> / <code>MPJQueryWrapper</code> 链式代码转换为 SQL</li>
            <li>参数替换：将 <code>?</code> 占位符替换为实际值（基本类型、对象、集合；同文件变量赋值自动追踪，LIKE 自动拼百分号）</li>
            <li>动态条件：布尔重载 <code>.eq(true, col, val)</code> 在预览左栏提供复选框开关，勾选/取消实时重生成 SQL</li>
            <li>SQL 自动格式化：关键字大写、子句换行缩进，支持多行/单行两种视图</li>
            <li>多种触发方式：右键菜单 / 快捷键（默认 <code>Alt+Shift+Q</code>）/ 代码左侧 gutter 图标，一键复制</li>
            <li>多数据库方言：MySQL / PostgreSQL / Oracle（分页子句差异化渲染）</li>
            <li>服务链式调用支持：<code>service.lambdaQuery()</code> / <code>lambdaUpdate()</code> 等约 264 处真实项目用法全覆盖</li>
            <li>逻辑删除注入：实体含 <code>@TableLogic</code> 时查询/删除自动追加 <code>AND deleted = 0</code>（可配置关闭）</li>
            <li>安全警示：UPDATE / DELETE 无 WHERE 条件时红色提示全表操作风险</li>
        </ul>
        <p>开发计划与功能概览见项目 <code>docs/</code> 目录。</p>
        <!-- M18 联系作者：外链二维码（base64/相对路径在插件描述中不可用，官方推荐外部 URL；
             图片存于仓库 docs/images/，raw 直链；二维码为限时码，更新图片后重新发布即可，URL 不变） -->
        <hr/>
        <h2>Author / 联系作者</h2>
        <p>Scan to add the author's WeChat / 扫码添加作者微信</p>
        <img src="https://gitee.com/songrenshuo/mybatis-plus-sql-visualizer/raw/master/docs/images/wechat-qr.png" width="220" height="220"/>
        <p>Scan to join the WeChat group / 扫码加入交流群</p>
        <img src="https://gitee.com/songrenshuo/mybatis-plus-sql-visualizer/raw/master/docs/images/group-qr.png" width="220" height="220"/>
        <!-- M18.1 问题反馈入口：跳转仓库 Issues 页（链接为白名单基础 HTML，IDE 与 Marketplace 均支持） -->
        <p>Found an issue? Please report it at <a href="https://gitee.com/songrenshuo/mybatis-plus-sql-visualizer/issues">Gitee Issues</a> / 遇到问题？请到仓库 Issues 页提交反馈</p>
        ]]></description>

    <!-- 插件变更说明（Marketplace 与 IDE 插件管理页「最新变化」展示；HTML 有限白名单 ul/li/b）——
         此前缺失导致各渠道显示停留在市场发布时的旧文案；内容覆盖自上次发布（v1.6/M12）以来的全部变更 -->
    <change-notes><![CDATA[
        <ul>
            <li>M18.1：介绍页新增「问题反馈」入口——点击跳转 Gitee 仓库 Issues 页提交反馈</li>
            <li>M18：插件介绍页底部展示作者微信与交流群二维码（IDE 插件管理页与市场页面均可显示）</li>
            <li>M17：「执行 SQL」按钮——预览面板选择数据源后自动创建临时 .sql 文件（Database 控制台绑定数据源），Ctrl+Enter 执行；兼容 IDEA 2025.3+，Community 版自动隐藏</li>
            <li>M16.3：修复设置语言切换保存失效（roaming 契约）、补全注释不显示（builder 返回值丢弃）、SELECT 空列名三处缺陷</li>
            <li>M16.2：SQL 补全三处回归修复 + 实体父类字段参与补全 + 表前缀/表后缀配置</li>
            <li>M16.1：修复中英文切换保存失效（移除 PluginSettings 双注册）</li>
            <li>M16：SQL 面板字段补全 + 注释提示（@Schema/@ApiModelProperty 四级优先级；位置感知：FROM 后提示表名、WHERE 后提示列名）</li>
            <li>M15：官方 API 全覆盖（union/selectSub/子查询条件/逻辑删除控制等）+ 服务链约 264 处真实用法 + 逻辑删除注入 + 字符串版 QueryWrapper/UpdateWrapper</li>
            <li>M14：设置页增强（界面语言切换/快捷键录制/表前缀后缀）+ 弹窗自适应与尺寸记忆 + 插件名统一</li>
            <li>M13：动态条件简化（复选框纯手动）+ LIKE 自动拼百分号 + 字段类型推断引号</li>
        </ul>
    ]]></change-notes>

    <!-- 插件兼容性声明
         （M14.7 动态插件支持）：仅依赖 com.intellij.java（内置模块，常驻加载）；
         移除 org.jetbrains.kotlin 运行时依赖——本插件不处理 Kotlin PSI，该依赖为模板遗留，
         且 Kotlin 插件不支持动态卸载（依赖非动态插件会导致本插件也无法免重启安装/更新）；
         kotlin-stdlib 由构建自动打包进插件 jar，功能不受影响 -->
    <depends>com.intellij.java</depends>

    <!-- M17 执行 SQL：com.intellij.database（数据源/控制台，仅 Ultimate 捆绑）——
         官方规范（Plugin Dependencies）：可选依赖须声明 optional="true" + config-file，
         主描述文件不得直接引用可选插件类（本插件经反射隔离调用，Community 下优雅降级）；
         database-optional.xml 存放可选插件存在时才激活的声明（当前无 EP 注册，为占位） -->
    <depends optional="true" config-file="database-optional.xml">com.intellij.database</depends>

    <!-- com.intellij 扩展点注册（M3 展示层 + M5 配置系统） -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 全局配置（application-level，F-16）——@Service(Service.Level.APP) 注解式注册（M16.1 移除 XML
             双注册：官方规范禁止 plugin.xml 与 @Service 并存，双注册导致持久化绑定错实例、语言切换保存失效） -->

        <!-- SQL 预览服务（project-level，M16 起为轻服务：@Service(Service.Level.PROJECT) 注解声明，
             IDE 自动发现，无需 XML 注册；获取方式不变 project.getService(SqlPreviewService::class.java)） -->

        <!-- 设置页：Settings → Tools → MyBatis-Plus SQL Visualizer
             （官方规范：必须用 applicationConfigurable 注册；com.intellij.configurable 为 abstract EP 不可直接注册；
              M16.1 修正：覆写 getDisplayName() 的 Configurable 必须声明 displayName 或 key 属性
              （Plugin DevKit 验证规则，缺失报错），故声明 bundle+key——key 由 IDE 默认 locale 解析；
              getDisplayName() 覆写保留作动态兜底（插件语言 zh/en 手动切换时以代码为准） -->
        <applicationConfigurable parentId="tools"
                                 id="cn.song.mybatisplus.visualizer.settings"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="configurable.settings.displayName"
                                 instance="cn.song.mybatisplus.visualizer.config.PluginSettingsConfigurable"/>

        <!-- M10 gutter 预览图标：Wrapper 锚点行显示预览 SQL 图标（快速路径单元素 O(1) 判定，见 M10 开发计划 §2.4） -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.SqlGutterLineMarkerProvider"/>

        <!-- M9 可编辑 SQL 的补全基础设施：预览语言 PSI + 补全器 + 文件类型 -->
        <lang.parserDefinition language="MP_SQL_Preview"
                               implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.SqlParserDefinition"/>
        <completion.contributor language="MP_SQL_Preview"
                               implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.SqlCompletionContributor"/>
        <fileType name="MP_SQL_Preview" extensions="mpsql" language="MP_SQL_Preview"
                  implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.SqlPreviewFileType"/>
    </extensions>

    <!-- Action 注册（F-04 右键菜单 + F-05 快捷键）；图标复用插件图标（M13.1） -->
    <actions>
        <!-- M16 i18n：text/description 引用 bundle 键（action.<id>.<prop> 约定，messages.MpSqlVisualizerBundle）；
             图标：/icons/sqlGutter.svg（与 gutter 预览图标共用，修复 /META-INF/pluginIcon.svg 无法解析——
             pluginIcon.svg 为插件图标约定路径，不作为 action 图标使用） -->
        <action id="cn.song.mybatisplus.visualizer.ConvertToSql"
                class="cn.song.mybatisplus.visualizer.actions.ConvertToSqlAction"
                text="action.cn.song.mybatisplus.visualizer.ConvertToSql.text"
                description="action.cn.song.mybatisplus.visualizer.ConvertToSql.description"
                icon="/icons/sqlGutter.svg">
            <!-- 右键菜单：编辑器弹出菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- 快捷键（M14.5 调整默认值）：Alt+Shift+Q（Q=Query，IDEA 默认 Keymap 未占用）；
                 原 Ctrl+Alt+S 与 IDE 打开 Settings 冲突、Ctrl+Alt+Q 为用户自选前的过渡默认；
                 Windows/Linux 与 macOS 各注册一份，可在 Keymap 或插件设置页修改 -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift Q"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift Q"/>
        </action>
    </actions>
</idea-plugin>
