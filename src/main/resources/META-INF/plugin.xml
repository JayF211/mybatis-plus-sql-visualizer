<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<!-- url：插件官网链接（idea-plugin 根元素属性，官方文档实证——显示在 JetBrains Marketplace 插件页的
     Plugin Homepage 入口；与 vendor url（厂商页 Gitee）分工互补） -->
<idea-plugin url="https://sql-visualizer.jvtools.cn">
    <!-- 插件唯一标识（FQN），发布后不可变更 -->
    <id>cn.song.mybatisplus.visualizer.mybatis-plus-sql-visualizer</id>

    <!-- 插件兼容 IDE 版本（T-M30：最低兼容降至 IDEA 2024.3，原 M17 强制要求 2025.3+）——
         since-build=243（2024.3 构建号前缀）；不设 until-build（兼容至最新）。
         构建平台为最低支持版本 Ultimate 2024.3.7.1，公共 API 向后兼容保证 2025.x/2026.x 可运行 -->
    <idea-version since-build="243"/>

    <!-- 消息 bundle 声明（M16 i18n）：plugin.xml 中 action text/description 按 action.<id>.<prop> 约定、
         configurable displayName 按 bundle+key 属性，从 messages.MpSqlVisualizerBundle（含 _zh）解析本地化 -->
    <resource-bundle>messages.MpSqlVisualizerBundle</resource-bundle>

    <!-- 插件显示名称（M13.1 统一为完整名） -->
    <name>SQL Visualizer</name>
    <!-- 插件图标：不声明 <icon>，走 IDEA 约定路径（jar 根 pluginIcon.svg / pluginIcon_dark.svg，亮暗主题自动切换，M14） -->

    <!-- 插件厂商（发布前请替换为真实信息） -->
    <vendor url="https://gitee.com/SongRenShuo">SongRenShuo</vendor>

    <!-- 插件描述（Marketplace 展示，支持 HTML；必须以拉丁字符开头且 ≥40 字符；双语：英文在上、中文在下，M16） -->
    <description><![CDATA[
        <p><b>See the exact SQL your code will run — before the server starts.</b> SQL Visualizer turns MyBatis-Plus Wrapper chains, XML mappers, annotation SQL, JPA/Hibernate queries and JdbcTemplate string SQL into readable, executable SQL with real parameter values, right inside IntelliJ IDEA.</p>
        <p>Compatible with every IntelliJ platform release since 2024.3 — including the full 2025.1–2025.3 line — continuously adapted.</p>
        <h3>Highlights</h3>
        <ul>
            <li><b>All SQL sources covered</b>: Lambda / Query / Update / Delete Wrappers &amp; service chains, MPJ join wrappers, mapper XML dynamic tags (if / foreach / choose ...), <code>@Select</code> annotation SQL, Spring Data <code>findByXxx</code>, CriteriaQuery, HQL / <code>@Query</code>, JdbcTemplate &amp; custom-DAO string SQL</li>
            <li><b>Real parameters, one click</b>: <code>?</code> placeholders replaced with actual values (LIKE auto-wildcard, type-aware quoting); OGNL condition checkboxes; auto formatting for 9 database dialects</li>
            <li><b>Live SQL log capture</b>: restores executable SQL from MyBatis / Hibernate / JdbcTemplate console logs, with de-dup, filtering, per-statement color marks and precise jump-to-source</li>
            <li><b>Enhanced capture, on by default</b>: a lightweight agent attached to the running app reports every statement with its target database, exact duration and affected row count — no log format required</li>
            <li><b>SQL → Java</b>: convert any SQL back into compilable QueryWrapper / LambdaQueryWrapper / Wrappers / MPJLambdaWrapper code (CRUD &amp; joins)</li>
            <li><b>JOIN diagram &amp; execution</b>: native IDE ER diagram with PNG / SVG export; execute SQL and one-click EXPLAIN plans in an embedded native Database console (Ultimate)</li>
            <li><b>CRUD SQL in one step</b>: right-click an entity class or database table to generate INSERT / UPDATE / SELECT / DELETE</li>
            <li><b>Rollback SQL in one click</b>: derive the reverse DELETE for an INSERT preview with identity-column wrapping for SQL Server and DM; snapshot-assisted recovery for UPDATE / DELETE</li>
            <li><b>MCP tools for AI agents</b>: 10 deterministic read-oriented tools (render, check, explain, rollback plan, CRUD, reverse SQL and more) registered with the platform MCP Server, per-tool gating in settings (IDEA 2025.2+)</li>
            <li>One keystroke away: gutter icon / context menu / <code>Alt+Shift+Q</code></li>
        </ul>
        <p>Feature matrix &amp; docs: <a href="https://sql-visualizer.jvtools.cn">sql-visualizer.jvtools.cn</a> · Screenshots on the <a href="https://plugins.jetbrains.com/plugin/33633-sql-visualizer">Marketplace page</a></p>
        <!-- M18.1 问题反馈入口：跳转官网需求池（链接为白名单基础 HTML，IDE 与 Marketplace 均支持） -->
        <p>Found an issue? Please report it at the <a href="https://sql-visualizer.jvtools.cn/about/feedback">Feedback Pool</a>.</p>
        <hr/>
        <p><b>服务未启，SQL 先知</b>——SQL Visualizer 在 IntelliJ IDEA 内将 MyBatis-Plus Wrapper 链、XML mapper、注解 SQL、JPA/Hibernate 查询与 JdbcTemplate 字符串 SQL 渲染为可读可执行的真实 SQL，参数值自动回填。</p>
        <p>支持 IDEA 2024.3 起全部版本（含 2025.1–2025.3 与 2026.x），持续适配。</p>
        <h3>核心能力</h3>
        <ul>
            <li><b>SQL 来源全覆盖</b>：Lambda / Query / Update / Delete Wrapper 及服务链、MPJ 联表、mapper XML 动态标签（if / foreach / choose 等）、<code>@Select</code> 注解 SQL、Spring Data 派生查询、CriteriaQuery、HQL / <code>@Query</code>、JdbcTemplate 与自研 DAO 字符串 SQL</li>
            <li><b>真实参数一键回填</b>：<code>?</code> 占位符替换为实际值（LIKE 自动拼百分号、按字段类型加引号）；OGNL 条件勾选模拟；9 种数据库方言自动格式化</li>
            <li><b>控制台 SQL 日志实时捕获</b>：支持 MyBatis / Hibernate / JdbcTemplate 三种日志格式，去重过滤、按语句类型着色标记、精确跳转源码</li>
            <li><b>增强捕获（默认开启）</b>：向运行中的应用进程挂载轻量 agent 直接采集真实执行，不依赖日志格式，附目标库、毫秒级耗时与影响行数</li>
            <li><b>SQL 反向转 Java</b>：一键生成可直接编译的 QueryWrapper / LambdaQueryWrapper / Wrappers / MPJLambdaWrapper 代码（增删改查与多表 JOIN）</li>
            <li><b>JOIN 关系图与执行</b>：IDE 原生 ER 图渲染（PNG / SVG 导出）；内嵌原生 Database 控制台直接执行 SQL 与一键执行计划 EXPLAIN（Ultimate）</li>
            <li><b>CRUD SQL 一步直出</b>：实体类 / 数据库表右键生成 INSERT / UPDATE / SELECT / DELETE</li>
            <li><b>一键回滚 SQL</b>：对预览的 INSERT 推导逆向 DELETE，SQL Server / 达梦自增列自动包装；UPDATE / DELETE 走快照回填恢复</li>
            <li><b>MCP 工具面向 AI agent</b>：10 个确定性只读工具接入平台 MCP Server（渲染 / 核查 / 执行计划 / 回滚预案 / CRUD / 反向转换等），设置页逐项门控（IDEA 2025.2+）</li>
            <li>触发零门槛：代码左侧 gutter 图标 / 右键菜单 / <code>Alt+Shift+Q</code></li>
        </ul>
        <p>功能矩阵与文档：<a href="https://sql-visualizer.jvtools.cn">sql-visualizer.jvtools.cn</a> · 截图见 <a href="https://plugins.jetbrains.com/plugin/33633-sql-visualizer">Marketplace 页面</a></p>
        <p>遇到问题？请到<a href="https://sql-visualizer.jvtools.cn/about/feedback">官网需求池</a>提交反馈。</p>
        ]]></description>

    <!-- 插件变更说明由 build.gradle.kts patchPluginXml.changeNotes 注入（M18.2）——
         此处不写 change-notes：patchPluginXml 自动注入会覆盖显式值，且 changelog 插件从
         CHANGELOG.md [Unreleased] 自动提取会取错分区（多 ### Added），显式配置在构建脚本 -->
    <!-- 插件兼容性声明
         （M14.7 动态插件支持）：仅依赖 com.intellij.java（内置模块，常驻加载）；
         移除 org.jetbrains.kotlin 运行时依赖——本插件不处理 Kotlin PSI，该依赖为模板遗留，
         且 Kotlin 插件不支持动态卸载（依赖非动态插件会导致本插件也无法免重启安装/更新）；
         kotlin-stdlib 由构建自动打包进插件 jar，功能不受影响 -->
    <depends>com.intellij.java</depends>
    <!-- T-M24-04 XML 预览：com.intellij.modules.xml（平台 bundled 模块，IDE 恒启用）——XML PSI 定位语句 + XML gutter 注册 -->
    <depends>com.intellij.modules.xml</depends>
    <!-- F-4：Kotlin Wrapper 链 gutter + 预览（org.jetbrains.kotlin 平台 bundled 插件，IDE 恒启用） -->
    <depends optional="true" config-file="kotlin-optional.xml">org.jetbrains.kotlin</depends>

    <!-- M17 执行 SQL：com.intellij.database（数据源/控制台，仅 Ultimate 捆绑）——
         官方规范（Plugin Dependencies）：可选依赖须声明 optional="true" + config-file，
         主描述文件不得直接引用可选插件类（本插件经反射隔离调用，Community 下优雅降级）；
         database-optional.xml 存放可选插件存在时才激活的声明（modelRelationProvider EP +
         T-CrudSql 数据库表右键 action——Community 下整文件不加载，实体类入口不受影响） -->
    <depends optional="true" config-file="database-optional.xml">com.intellij.database</depends>

    <!-- T-Dgm-01 JOIN 图原生渲染：com.intellij.diagram（Ultimate 捆绑 "Diagrams"，类图/关系图底座）——
         与 database 同为可选依赖；diagram-optional.xml 注册 diagram.Provider（SqlJoinDiagramProvider），
         Community / Diagrams 缺席时经 NativeJoinDiagramSupport 门面降级回自绘 DiagramPanel -->
    <depends optional="true" config-file="diagram-optional.xml">com.intellij.diagram</depends>

    <!-- T-McpToolset MCP 能力一期：com.intellij.mcpServer（平台内置 MCP Server 插件，253+/262 内置，
         243 不支持——旧 EP 形态适配成本>收益，见 CHANGELOG）——mcp-optional.xml 注册
         mcpServer.mcpToolset（十个只读工具，一工具一 toolset 类，清单见 mcp-optional.xml）。
         未装该插件的环境整文件不加载，
         插件其余功能零影响；编译期类型来自 mcpStub 桩源集（本机构建辅助，见 build.gradle.kts 注释） -->
    <depends optional="true" config-file="mcp-optional.xml">com.intellij.mcpServer</depends>

    <!-- T-AcpMcpTransport ACP 会话 MCP 工具下发修复：com.intellij.ml.llm（JetBrains AI Assistant，
         ACP agent 宿主，Marketplace 独立插件、非发行版捆绑）——acp-transport-optional.xml 注册
         com.intellij.ml.llm.agents.acp.ideaMcpTransportProvider，让 Claude Agent 会话以 SSE 形式
         拿到 IDE 私有 IJ MCP 会话，绕过上游 claude-agent-acp 对带 type 字段的 stdio server 的静默丢弃
         （根因与三条机会见 20260919-2130-T-AcpMcpTransport 开发计划 §1.3/§1.5）。
         未装该插件的环境整文件不加载，插件其余功能零影响；主文件不得直接引用 ml-llm 类型
         （与 database/mcp 可选依赖同款铁律，见 AcpTransportScopeSourceScanTest 守卫）；
         编译期类型来自 mcpStub 桩源集（见 build.gradle.kts 注释） -->
    <depends optional="true" config-file="acp-transport-optional.xml">com.intellij.ml.llm</depends>

    <!-- com.intellij 扩展点注册（M3 展示层 + M5 配置系统） -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- M56 T-M56-09：EP 双轨主通道——控制台行捕获（首行标志生效后桥轮询挂载停转） -->
        <consoleFilterProvider implementation="cn.song.mybatisplus.visualizer.log.SqlConsoleBridgeFilterProvider"/>
        <!-- T-M56Phase2-Premain：启动即捕获补位——Java 运行配置准备期向 VM 参数注入
             -javaagent:<agent jar 绝对路径>=port=<n>;logLevel=warn（EP 由 com.intellij.java 声明，
             :66 硬依赖已在位；注册形态与平台自家十余处 runConfigurationExtension 同形，无需 epName）。
             是否注入由 AgentManager 的「增强开关 + 注入确认」两道闸门决定：未开启/未确认零注入，
             注入链任何失败只记日志、回落 attach/桥，不影响用户 Run -->
        <runConfigurationExtension implementation="cn.song.mybatisplus.visualizer.log.agent.PremainRunConfigurationExtension"/>
        <!-- 全局配置（application-level，F-16）——@Service(Service.Level.APP) 注解式注册（M16.1 移除 XML
             双注册：官方规范禁止 plugin.xml 与 @Service 并存，双注册导致持久化绑定错实例、语言切换保存失效） -->

        <!-- SQL 预览服务（project-level，M16 起为轻服务：@Service(Service.Level.PROJECT) 注解声明，
             IDE 自动发现，无需 XML 注册；获取方式不变 project.getService(SqlPreviewService::class.java)） -->

        <!-- 设置页：Settings → Tools → SQL Visualizer
             （左侧树导航：父节点为文件夹，5 个子节点各自显示独立页面） -->
        <applicationConfigurable parentId="tools"
                                 id="cn.song.mybatisplus.visualizer.settings"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="configurable.settings.displayName"
                                 instance="cn.song.mybatisplus.visualizer.config.PluginSettingsFolderConfigurable"/>

        <!-- T-SettingsTruth P4：项目级设置页（project-level）——项目级 configurable 不得挂在
             应用级 configurable 之下（平台限制），挂 tools 顶层与全局页平级 -->
        <projectConfigurable parentId="tools"
                             id="cn.song.mybatisplus.visualizer.settings.project"
                             bundle="messages.MpSqlVisualizerBundle"
                             key="configurable.settings.project.displayName"
                             instance="cn.song.mybatisplus.visualizer.config.ProjectPluginSettingsConfigurable"/>

        <!-- 子页面顺序由 groupWeight 决定：平台 Weighted.COMPARATOR 按 weight 降序优先、displayName
             自然比较兜底；不设 weight 时 displayName 比较会随插件语言变化导致中英文子项顺序不一致
             （中文按码点序重排），故显式声明与声明序一致的递减 weight（ui=50 → about=10）。
             新增子页面时按区间插值取 weight，保持英文版既定顺序。 -->
        <!-- 界面与操作（gutter图标/语言；快捷键已独立为快捷键子页） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.ui"
                                 groupWeight="50"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.ui"
                                 instance="cn.song.mybatisplus.visualizer.config.UiActionsConfigurable"/>

        <!-- T-ShortcutSettings：快捷键统一管理（5 个动作快捷键内嵌录制编辑） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.shortcuts"
                                 groupWeight="45"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.shortcuts"
                                 instance="cn.song.mybatisplus.visualizer.config.ShortcutsConfigurable"/>

        <!-- SQL 预览（方言/参数替换/逻辑删除/多租户/数据权限/反向转换） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.preview"
                                 groupWeight="40"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.preview"
                                 instance="cn.song.mybatisplus.visualizer.config.SqlPreviewConfigurable"/>

        <!-- 表名映射（前缀/后缀/移除/忽略字段/推断策略） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.tableMapping"
                                 groupWeight="30"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.tableMapping"
                                 instance="cn.song.mybatisplus.visualizer.config.TableMappingConfigurable"/>

        <!-- SQL 日志（前缀/自动捕获/时间戳/格式化/过滤/去重/最大条数/耗时/慢查询/Hibernate/Jdbc/自动保存） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.sqlLog"
                                 groupWeight="20"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.sqlLog"
                                 instance="cn.song.mybatisplus.visualizer.config.SqlLogConfigurable"/>

        <!-- T-ShortcutSettings：MCP 工具；T-McpToolset2/T-MTS2-00 增补门控区（总开关+工具级启用禁用，McpToolGate） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.mcp"
                                 groupWeight="15"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.mcp"
                                 instance="cn.song.mybatisplus.visualizer.config.McpConfigurable"/>

        <!-- 关于（缓存/更新/构建号/导入导出） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.about"
                                 groupWeight="10"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.about"
                                 instance="cn.song.mybatisplus.visualizer.config.AboutConfigurable"/>

        <!-- M10 gutter 预览图标：Wrapper 锚点行显示预览 SQL 图标（快速路径单元素 O(1) 判定，见 M10 开发计划 §2.4） -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.SqlGutterLineMarkerProvider"/>
        <!-- F-4：Kotlin Wrapper 链 gutter 图标（复用 SqlGutterLineMarkerProvider，Kotlin 语言注册）——
             注册移至 kotlin-optional.xml（org.jetbrains.kotlin 可选依赖存在时加载），避免主描述文件
             引用可选插件语言 ID 导致校验报错「无法解析 ID 为 'Kotlin' 的语言」 -->
        <!-- T-M25-03 注解预览：MyBatis SQL 注解（@Select/@Insert/@Update/@Delete 及 Provider 族）行显示预览图标（O(1) 语法判定） -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.AnnotationSqlGutterLineMarkerProvider"/>

        <!-- T-M24-04 XML 预览：mapper 语句（select/insert/update/delete）行显示预览图标（O(1) 标签名判定） -->
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.XmlSqlGutterLineMarkerProvider"/>
        <!-- F-45 maintainPage XML 预览：<maintainPage> 行显示预览图标（O(1) 标签名判定） -->
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.PagesXmlGutterLineMarkerProvider"/>
        <!-- T-H2 hbm 命名查询预览：<hibernate-mapping> 下 <query>/<sql-query> 行显示预览图标（O(1) 标签名判定） -->
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.HbmNamedQueryGutterLineMarkerProvider"/>
        <!-- O-72 T-XmlInlineSql 通用内嵌 SQL 预览：叶子标签文本首词命中 SQL 关键字即认领（内容判定，不限根元素/标签名；mapper/pages/hbm 之后兜底） -->
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.XmlInlineSqlGutterLineMarkerProvider"/>

        <!-- F-14 JPA：Repository 推导方法（findByXxx）行显示预览图标 -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.JpaGutterLineMarkerProvider"/>

        <!-- 波次一：JPA JPQL/@Query 注解（@Query）行显示预览图标 -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.JpqlGutterLineMarkerProvider"/>

        <!-- 波次一：JPA CriteriaQuery 调用链（cq.from/cb.equal 等）行显示预览图标 -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.CriteriaQueryGutterLineMarkerProvider"/>

        <!-- 波次二：Hibernate HQL（session.createQuery）行显示预览图标 -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.HqlGutterLineMarkerProvider"/>

        <!-- 波次二：自定义 DAO HQL（commonDao.findByQuery 等）行显示预览图标 -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.CustomDaoHqlGutterLineMarkerProvider"/>

        <!-- JDBC 模板 SQL 字符串预览：queryForList/update 等方法的字符串 SQL 实参行显示预览图标（O(1) 方法名判定） -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.JdbcTemplateSqlGutterLineMarkerProvider"/>

        <!-- T-PreviewShortcut：实体级 @NamedQuery/@NamedQueries 预览图标（锚 @NamedQuery 注解的 @ token） -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.NamedQueryGutterLineMarkerProvider"/>

        <!-- T-DaoSql-04：方法定义锚点（方法体内存在字符串 SQL 调用时方法名行显示预览图标，
             覆盖自研框架 DAO 委托链场景；daemon 快速路径限单方法体结构遍历，见开发计划性能论证） -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.StringSqlMethodGutterLineMarkerProvider"/>

        <!-- T-InsertColumnInlay O-44b：预览面板 INSERT 语句的目标列 inlay 提示（VALUES 表达式 /
             SELECT 投影挂列名，投影自带同名列别名时去重）。
             EP 全名 com.intellij.codeInsight.inlayProvider（平台 LangExtensionPoints.xml 声明，
             bean=InlayHintsProviderExtensionBean，language 与 implementationClass 均为 @RequiredElement）。
             **注册是 language 级**——对 IDE 内所有 SQL 编辑器生效（含用户自己的 .sql 文件），
             故 provider 内必须做「只认本面板预览编辑器」的双锚点判定（文件名 + userData），
             见 PreviewInsertColumnInlayProvider KDoc 与开发计划 §六 风险表首行。
             不注册 settingsKeyId：平台按「无匹配 bean → 默认开启」口径放行，用户可用平台
             全局/语言级 inlay 开关关闭（本插件不新增设置页） -->
        <codeInsight.inlayProvider language="SQL"
                                   implementationClass="cn.song.mybatisplus.visualizer.ui.inlay.PreviewInsertColumnInlayProvider"/>

        <!-- M9→原生SQL：补全注册到 SQL 语言。实测全语言注册（无 language）在补全调度时不被
     CompletionContributor.forLanguage 返回（M34 补全失效根因之一），必须显式 language；
     SQL 文件（IDEA DatabaseTools：com.intellij.sql.SqlLanguage，id="SQL"）由
     editor.getFileType().language 匹配。 -->
        <completion.contributor language="SQL"
                                implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.SqlCompletionContributor"/>

        <!-- M27 XML/注解 SQL 代码补全（T-M27-03/05，方案 B 自研，Community 兼容）：mapper 语句
             文本与 @Select 等注解字符串内——SQL 关键字/表名/列名/`别名.` 前缀列/#{} 参数名/
             XML 动态标签与 OGNL 属性（守卫 O(1) 语法判定，实体解析仅补全触发时执行） -->
        <completion.contributor language="XML"
                                implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.XmlSqlCompletionContributor"/>
        <completion.contributor language="JAVA"
                                implementationClass="cn.song.mybatisplus.visualizer.ui.highlight.AnnotationSqlCompletionContributor"/>

        <!-- F-5 Wrapper 方法链智能补全：Java 文件中 Wrapper 链上下文感知的方法名/实体字段补全（O(1) 文本判定，无 resolve） -->
        <completion.contributor language="JAVA"
                                implementationClass="cn.song.mybatisplus.visualizer.ui.completion.WrapperCompletionContributor"/>

        <!-- M28 插件更新：启动自动检查（开关默认关，PluginSettings.autoCheckUpdate=false，T-PerfSweep2-06 对齐代码权威；稳定版由 Marketplace 推送，内测期手动开启）——静默检查，
             仅发现新版本时弹通知（[立即更新] 后台下载安装 / [稍后]）；分组显示名走 bundle
             （NotificationGroupEP 无 displayName 属性，243 平台 javap 实证：bundle + key 本地化） -->
        <notificationGroup id="cn.song.mybatisplus.visualizer.updates"
                           bundle="messages.MpSqlVisualizerBundle"
                           key="notification.group.updates"
                           displayType="BALLOON"/>
        <!-- O-4：预览弹窗操作 toast（复制可执行 SQL / Diff 结果提示） -->
        <notificationGroup id="cn.song.mybatisplus.visualizer.preview"
                           bundle="messages.MpSqlVisualizerBundle"
                           key="notification.group.preview"
                           displayType="BALLOON"/>
        <!-- T-ErrReport 错误一键上报：注册后 IDE Internal Errors 对话框对本插件错误出现
             「报告到 SQL Visualizer 需求池」按钮——平台按错误归属插件解析（IdeErrorsDialog
             getSubmitter(Throwable, PluginId)，com.intellij.errorHandler EP dynamic，
             243 平台 jar javap 实证，见开发计划 20260908-1259 §四） -->
        <errorHandler implementation="cn.song.mybatisplus.visualizer.feedback.IdeErrorReportSubmitter"/>
        <!-- T-ErrReport：提交结果 toast（成功 FR 编号 + 查看详情 / 失败原因） -->
        <notificationGroup id="cn.song.mybatisplus.visualizer.feedback"
                           bundle="messages.MpSqlVisualizerBundle"
                           key="notification.group.feedback"
                           displayType="BALLOON"/>
        <!-- T-SqlSuppress（O-69/D5）：SQL 屏蔽规则 balloon（右键屏蔽成功反馈 + 达上限提示 + 管理直达）——
             独立组：既有三组各属独立域（updates 更新 / preview 预览 toast / feedback 错误上报），
             屏蔽反馈复用会张冠李戴，照「一域一组」惯例新增 -->
        <notificationGroup id="cn.song.mybatisplus.visualizer.logsuppress"
                           bundle="messages.MpSqlVisualizerBundle"
                           key="notification.group.logsuppress"
                           displayType="BALLOON"/>
        <postStartupActivity implementation="cn.song.mybatisplus.visualizer.update.StartupUpdateCheck"/>

        <!-- T-M31.14 日志自动监听：设置「项目启动时自动开始监听」开启时项目打开即挂载控制台监听 -->
        <postStartupActivity implementation="cn.song.mybatisplus.visualizer.log.LogStartupCapture"/>

        <!-- T-UxOnboard T-UX-01：首用锚点一次性引导——编辑器打开事件节流探测（低频入口），
             检测到可预览 SQL 时经预览组弹一次「Alt+Shift+Q」指路通知；一次性状态持久化
             （PluginSettings.onboardingAnchorTipShown），gutter 快速路径零改动 -->
        <postStartupActivity implementation="cn.song.mybatisplus.visualizer.onboarding.OnboardingAnchorTip"/>

        <!-- T-M31 日志还原：MyBatis SQL 日志工具窗口（自动监听运行控制台 Preparing/Parameters
             → 还原可执行 SQL；交互参考 MybatisCodeHelperPro「MyBatis Log」面板）
             T-M31.2：侧边栏图标 /icons/sqlLog.svg（MP 蓝圆角 + </>，修复默认圆形图标）
             T-M40：三处图标统一——sqlLog 蓝底白字版 + 右下角放大镜前景层（玻璃盘浅蓝实色垫底、代码顶层、空心环），无底版实测不理想已回退（sqlLog_bg.svg 为同内容备份） -->
        <!-- F-44：主侧边栏（4 tabs：SQL 日志/日志转SQL/SQL→Java/历史） -->
        <toolWindow id="cn.song.mybatisplus.visualizer.log" anchor="right"
                    icon="/icons/sqlLog.svg"
                    factoryClass="cn.song.mybatisplus.visualizer.log.SqlLogToolWindowFactory"/>
        <!-- F-44：SQL 历史记录已合并到主侧边栏 tab，不再独立注册；
             T-UN-12（T-UiNative）：独立历史 ToolWindow 工厂类已删除 -->
    </extensions>

    <!-- T-M53：Kotlin plugin mode 声明——本插件只用 Kotlin PSI（gutter 标记），不涉及 Analysis API，
         K1/K2 双模式均安全；supportsK1 默认 true，显式声明 supportsK2 消除 verifyPlugin
         「Plugin does not declare Kotlin plugin mode」警告。须在主描述文件声明（verifier 不合并
         可选配置文件 kotlin-optional.xml）；Kotlin 插件不存在时未知 EP 会被平台容忍跳过 -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <!-- Action 注册（F-04 右键菜单 + F-05 快捷键）；图标复用插件图标（M13.1） -->
    <actions>
        <!-- M16 i18n：text/description 引用 bundle 键（action.<id>.<prop> 约定，messages.MpSqlVisualizerBundle）；
             图标：/icons/sqlGutter.svg（与 gutter 预览图标共用，修复 /META-INF/pluginIcon.svg 无法解析——
             pluginIcon.svg 为插件图标约定路径，不作为 action 图标使用；T-M40：三笔对称居中 + 右下角放大镜前景层） -->
        <action id="cn.song.mybatisplus.visualizer.ConvertToSql"
                class="cn.song.mybatisplus.visualizer.actions.ConvertToSqlAction"
                text="action.cn.song.mybatisplus.visualizer.ConvertToSql.text"
                description="action.cn.song.mybatisplus.visualizer.ConvertToSql.description"
                icon="/icons/sqlGutter.svg">
            <!-- 右键菜单：编辑器弹出菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- 快捷键（M14.5 调整默认值）：Alt+Shift+Q（Q=Query，IDEA 默认 Keymap 未占用）；
                 原 Ctrl+Alt+S 与 IDE 打开 Settings 冲突、Ctrl+Alt+Q 为用户自选前的过渡默认；
                 Windows/Linux 与 macOS 各注册一份，可在 Keymap 或插件设置页修改 -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift Q"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift Q"/>
        </action>

        <!-- P0 SQL 反向转换：选中 SQL → MyBatis-Plus QueryWrapper Java 代码（右键菜单 + Alt+Shift+J；
             与 ConvertToSql 正向转换互补；不依赖 PSI，任何文件类型选择区可用） -->
        <action id="cn.song.mybatisplus.visualizer.ConvertSqlToJava"
                class="cn.song.mybatisplus.visualizer.actions.ConvertSqlToJavaAction"
                text="action.cn.song.mybatisplus.visualizer.ConvertSqlToJava.text"
                description="action.cn.song.mybatisplus.visualizer.ConvertSqlToJava.description"
                icon="/icons/sqlGutter.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift J"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift J"/>
        </action>

        <!-- T-CrudSql：实体类右键生成 CRUD SQL（编辑器 + 项目视图；update 判定 MP 实体注解；
             展示复用现有 SqlSelectionDialog + SqlPreviewService.showResult，零新弹窗；
             数据库表节点入口在 database-optional.xml——com.intellij.database 在场时才加载） -->
        <action id="cn.song.mybatisplus.visualizer.GenerateCrudSqlFromEntity"
                class="cn.song.mybatisplus.visualizer.actions.GenerateCrudSqlFromEntityAction"
                text="action.cn.song.mybatisplus.visualizer.GenerateCrudSqlFromEntity.text"
                description="action.cn.song.mybatisplus.visualizer.GenerateCrudSqlFromEntity.description"
                icon="/icons/sqlGutter.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- T-PreviewUx-Pack #3：${table} 快捷模板三动作（选中表名一键 EXPLAIN / COUNT / 抽样 10 行；
             三动作共享一个 group 注册 EditorPopupMenu，与「生成 CRUD SQL」入口并存不合并菜单；
             执行走既有内嵌控制台链路（DataSourceSelector + SqlExecutor），凭证不出 IDE；
             T-TemplateKeyDrop：三动作不设默认键位——原 Alt+Shift+E/C/T 与平台动作冲突
             （RecentChanges / tasks.switch），而备选键 Ctrl+Alt+Shift+同字母同样被占（Copy Reference /
             Refactor This），「冲突自动换绑」无解（实测见开发计划 §一）；改为由用户在设置页
             「快捷键」节或 IDE 的 Settings > Keymap 自行录制，右键菜单入口不受影响） -->
        <!-- 组文案由 class 提供（2026-09-23 真机走查修复）：<group> 的 text 属性不走 bundle 解析——
             只写 text= 或再补 bundle= 都会在右键菜单里显示原始键（实测；同文件 <action> 的 text+bundle
             正常）。平台对本地化组的正规做法是给 class，见 SqlTemplateGroup KDoc。 -->
        <group id="cn.song.mybatisplus.visualizer.SqlTemplateGroup"
               class="cn.song.mybatisplus.visualizer.actions.SqlTemplateGroup"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="cn.song.mybatisplus.visualizer.ExplainSelectedTable"
                    class="cn.song.mybatisplus.visualizer.actions.ExplainSelectedTableAction"
                    text="action.cn.song.mybatisplus.visualizer.ExplainSelectedTable.text"
                    description="action.cn.song.mybatisplus.visualizer.ExplainSelectedTable.description"
                    icon="/icons/sqlGutter.svg">
            </action>
            <action id="cn.song.mybatisplus.visualizer.CountSelectedTable"
                    class="cn.song.mybatisplus.visualizer.actions.CountSelectedTableAction"
                    text="action.cn.song.mybatisplus.visualizer.CountSelectedTable.text"
                    description="action.cn.song.mybatisplus.visualizer.CountSelectedTable.description"
                    icon="/icons/sqlGutter.svg">
            </action>
            <action id="cn.song.mybatisplus.visualizer.SampleSelectedTable"
                    class="cn.song.mybatisplus.visualizer.actions.SampleSelectedTableAction"
                    text="action.cn.song.mybatisplus.visualizer.SampleSelectedTable.text"
                    description="action.cn.song.mybatisplus.visualizer.SampleSelectedTable.description"
                    icon="/icons/sqlGutter.svg">
            </action>
        </group>

        <!-- T-ErrReport：帮助菜单反馈入口（手动形态报告对话框，提交直达官网需求池；
             对话框底部提供带 source/ideVersion/pluginVersion 参数的浏览器兜底链接） -->
        <action id="cn.song.mybatisplus.visualizer.Feedback"
                class="cn.song.mybatisplus.visualizer.feedback.FeedbackAction"
                text="action.cn.song.mybatisplus.visualizer.Feedback.text"
                description="action.cn.song.mybatisplus.visualizer.Feedback.description">
            <add-to-group group-id="HelpMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
