<!-- F-4：Kotlin 可选依赖配置（org.jetbrains.kotlin 存在时加载） -->
<idea-plugin>
    <!-- F-4：复用行标提供器接收 Kotlin PSI；当前无法可靠求表列的 Wrapper 链由提供器 fail-closed 隐藏，
         主动 Convert to SQL 入口另给非模态说明。仅在 Kotlin 插件存在、语言 ID 可解析时加载。 -->
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="Kotlin"
                                        implementationClass="cn.song.mybatisplus.visualizer.ui.gutter.SqlGutterLineMarkerProvider"/>
    </extensions>
</idea-plugin>
