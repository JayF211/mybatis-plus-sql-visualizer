# 本机路径与代理覆盖（可选）——复制为 .local/local.env 后按需填写。
# 键留空、或本文件不存在时，dev-support 下的脚本会自行动态发现或用相对路径推导。
#
# 用法（bash）：
#   set -a; . .local/local.env; set +a
# run-verifier.sh 已内置加载（存在才 source，POSIX 用点号）。
#
# 行尾必须是 LF（.gitattributes 已把 *.env 与 *.env.example 钉为 LF）：CRLF 会让每个赋值
# 尾部带上不可见的回车字符，值被静默污染（端口会变成「7890 加一个回车」，报错还很难定位）。

# Verifier CLI jar 路径。留空＝从 $HOME/.gradle 的 caches 动态发现。
MPSV_VERIFIER_JAR=

# 运行 verifier / 其他工具用的 JDK。留空＝$JAVA_HOME，再退回 PATH 上的 java。
MPSV_JAVA=

# 三个目标 IDE 发行版目录。留空＝从 gradle caches 动态发现。
MPSV_IDE_243=
MPSV_IDE_253=
MPSV_IDE_262=

# demo 工程根目录（mcp-test/mpsv-mcp-test.mjs 与 e2e-fake-ide/run-e2e.sh 使用）。
MPSV_DEMO_ROOT=

# Maven 可执行文件（e2e-fake-ide/run-e2e.sh 使用；留空＝PATH 上的 mvnd / mvn）。
MPSV_MVN=

# 代理。留空或不设＝脚本用其内置默认值；设为空串可显式关闭代理。
MPSV_PROXY_HOST=
MPSV_PROXY_PORT=
